# Copia a .env y ajusta. En el servidor lo genera deploy/scripts/bootstrap-server.sh.

# ── Dominio y HTTPS (Caddy obtiene el certificado de Let's Encrypt solo) ──────
DOMAIN=revistas.midominio.com
ACME_EMAIL=admin@midominio.com

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
POSTGRES_PASSWORD=cambia-esto

# ── Seguridad de la API ──────────────────────────────────────────────────────
# Firma de tokens: >= 32 caracteres aleatorios (openssl rand -hex 32)
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-de-64-caracteres
# Contraseña del modo editor (editar/añadir/importar revistas). Vacía = edición deshabilitada.
ADMIN_PASSWORD=cambia-esto

# ── Imágenes (las fija deploy.sh en cada despliegue) ─────────────────────────
IMAGE_PREFIX=ghcr.io/usuario/recomendador_revistas
IMAGE_TAG=latest
